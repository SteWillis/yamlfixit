    "common_join_paths": [
      {
        "name": "Full Booking Lineage",
        "description": "Traverse from individual booking up to warehouse, location, and user",
        "sql": "SELECT \n    b.id AS booking_id,\n    b.status,\n    b.pallets,\n    b.haulier_carrier,\n    b.delivery_number,\n    b.destination,\n    b.vehicle_type,\n    s.date AS booking_date,\n    s.start_time AS slot_start,\n    s.end_time AS slot_end,\n    c.name AS calendar_name,\n    c.calendar_type,\n    w.name AS warehouse_name,\n    l.name AS location_name,\n    u.username,\n    u.company_name\nFROM bookings b\nJOIN slots s ON b.slot_id = s.id\nJOIN calendars c ON s.calendar_id = c.id\nJOIN warehouses w ON c.warehouse_id = w.id\nJOIN locations l ON w.location_id = l.id\nJOIN users u ON b.user_id = u.id;"
      },
      {
        "name": "User Calendar Permission Check",
        "description": "Determine whether a user has entitlement to book a given calendar based on group rules",
        "sql": "SELECT \n    u.username,\n    u.company_name,\n    g.name AS group_name,\n    g.booking_min_days,\n    g.booking_max_days,\n    c.name AS accessible_calendar,\n    w.name AS warehouse_name\nFROM users u\nJOIN user_groups ug ON u.id = ug.user_id\nJOIN groups g ON ug.group_id = g.id\nJOIN group_calendar_access gca ON g.id = gca.group_id\nJOIN calendars c ON gca.calendar_id = c.id\nJOIN warehouses w ON c.warehouse_id = w.id;"
      },
      {
        "name": "Daily Pallet Capacity Utilization",
        "description": "Compare total pallets booked against the daily max pallets limit per calendar",
        "sql": "SELECT \n    c.name AS calendar_name,\n    s.date,\n    c.default_max_pallets_per_day AS calendar_daily_limit,\n    s.max_pallets_per_day AS slot_daily_limit,\n    COUNT(b.id) AS total_bookings,\n    SUM(COALESCE(b.pallets, 0)) AS total_pallets_booked\nFROM calendars c\nJOIN slots s ON c.id = s.calendar_id\nLEFT JOIN bookings b ON s.id = b.slot_id AND b.status IN ('confirmed', 'completed')\nGROUP BY c.id, c.name, s.date, c.default_max_pallets_per_day, s.max_pallets_per_day;"
      }
    ]
  },
